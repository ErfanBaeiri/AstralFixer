@using BugFixer.Application.Statics
@using BugFixer.Domain.Entities.Questions
@using BugFixer.Application.Extensions;
@model List<Answer>

@if (Model != null && Model.Any())
{
    @foreach (var Answer in Model)
    {
        <div class="answer-item">
            <div class="top-detail">
                <span> @Answer.CreateDate.AsTimeAgo() </span>
                <button onclick="LoadUrl('@Url.Action("EditAnswer","Question", new {answerId = Answer.Id})')"><i class="icon-pencil-edit"></i></button>
            </div>
            <div class="inner">
                @Html.Raw(Answer.Content)
                <div class="rating-layer">
                    <div class="scoring-layer">
                        <button onclick="ScoreUpForAnswer(@Answer.Id)" class="plus"><i class="icon-caret-up"></i></button>
                        <span> @Answer.Score </span>
                        <button onclick="ScoreDownForAnswer(@Answer.Id)" class="negative"><i class="icon-caret-down"></i></button>
                    </div>
                    <div class="selected-answer">
                        @if (Answer.IsTrue)
                        {
                            <button onclick="selectTrueAnswer(@Answer.Id)" class="selected"><i class="icon-check"></i></button>
                        }
                        else
                        {
                            <button onclick="selectTrueAnswer(@Answer.Id)"><i class="icon-check"></i></button>
                        }
                    </div>
                </div>

            </div>

            <div class="detail-layer">
                <div class="author">
                    <a href="javascript:void(0)" class="img-layer">
                        <img src="@(PathTools.UserAvatarPath+Answer.User.Avatar)">
                    </a>
                    <h3><a href="javascript:void(0)"> @Answer.User.GetUserDisplayName() </a></h3>
                </div>
            </div>
        </div>
    }
}

else
{
    <div class="alert alert-warning">
        برای این پرسش پاسخی یافت نشد
    </div>
}



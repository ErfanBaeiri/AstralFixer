@if (TempData["SuccessMessage"] != null)
{
    <script>
        $(document).ready(function () {
            swal({
                title: "اعلان!",
                text: "@TempData["SuccessMessage"]",
                icon: "success",
                button: "باشه",
            });
        });
    </script>
}


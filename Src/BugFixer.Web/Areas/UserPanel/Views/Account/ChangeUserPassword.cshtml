@using BugFixer.Domain.ViewModels.UserPanel.Account
@model ChangeUserPasswordViewModel
@{
    ViewData["Title"] = "تغییر گذر واژه";
    Layout = "~/Areas/UserPanel/Views/Shared/_UserPanelLayout.cshtml";
}

@section Scripts {
    <partial name="_JqueryValidation" />
}

@section BreadCrumb {
    <li itemtype="http://schema.org/ListItem" itemscope itemprop="itemListElement"><a href="javascript:void(0)" itemprop="item"><span itemprop="name"> @ViewData["Title"] </span></a></li>
}

<!-- left side -->
<div class="account-content-layer layer-style">
    <h3> @ViewData["Title"]  </h3>
    <div class="inner">
        <form class="form-layer-style" method="post" asp-action="ChangeUserPassword" asp-controller="Account" asp-area="UserPanel">
            <div class="row">

                <div class="col-md-12 col-sm-12 col-xs-12">
                    <!-- input -->
                    <div class="input-layer">
                        <label asp-for="CurrentPassword"></label>
                        <input type="password" asp-for="CurrentPassword">
                        <span asp-validation-for="CurrentPassword"></span>
                    </div>
                    <!--/ input -->
                </div>

                <div class="col-md-6 col-sm-12 col-xs-12">
                    <!-- input -->
                    <div class="input-layer">
                        <label asp-for="NewPassword"></label>
                        <input type="password" asp-for="NewPassword">
                        <span asp-validation-for="NewPassword"></span>
                    </div>
                    <!--/ input -->
                </div>

                <div class="col-md-6 col-sm-12 col-xs-12">
                    <!-- input -->
                    <div class="input-layer">
                        <label asp-for="ConfirmNewPassword"></label>
                        <input type="password" asp-for="ConfirmNewPassword">
                        <span asp-validation-for="ConfirmNewPassword"></span>
                    </div>
                    <!--/ input -->
                </div>

                <div class="col-md-3 col-sm-3 col-xs-12 pull-left">
                    <button type="submit" class="submit-button green"> <span>ثبت تغییرات</span> </button>
                </div>

            </div>

        </form>
    </div>
</div>





